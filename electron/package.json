{
  "name": "eco-toolbox",
  "version": "0.2.21",
  "description": "ECO 本地工具箱：NPC 实时翻译、伤害统计、状态悬浮窗与技能计时",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "npm run build:ui && electron .",
    "dev": "concurrently -k -n vite,electron -c cyan,magenta \"vite\" \"node scripts/dev-electron.mjs\"",
    "dev:demo": "set ECO_UI_DEMO=1&& electron .",
    "build:ui": "vite build",
    "build:ts": "tsc --build",
    "test": "node --test test/*.test.js",
    "smoke": "node scripts/smoke.mjs",
    "build:backend": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-backend.ps1",
    "build:icons": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-icon-helper.ps1",
    "build:xiaoya-core": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-xiaoya-core.ps1",
    "test:xiaoya-core": "npm run build:xiaoya-core && node scripts/test-xiaoya-core.js",
    "build:prepackaged": "npm run build:ui && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-prepackaged.ps1",
    "dist": "npm run build:backend && npm run build:icons && npm run build:xiaoya-core && npm run dist:ui",
    "dist:ui": "npm run build:prepackaged && set ELECTRON_BUILDER_BINARIES_MIRROR=https://npmmirror.com/mirrors/electron-builder-binaries/&& electron-builder --prepackaged release/win-unpacked --win nsis --publish never"
  },
  "dependencies": {
    "electron-updater": "^6.6.2",
    "iconv-lite": "^0.6.3",
    "lucide": "^0.468.0"
  },
  "devDependencies": {
    "@mantine/core": "^7.17.0",
    "@mantine/hooks": "^7.17.0",
    "@mantine/notifications": "^7.17.0",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "concurrently": "^10.0.4",
    "electron": "^35.0.0",
    "electron-builder": "^26.0.0",
    "lucide-react": "^1.26.0",
    "motion": "^12.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^6.4.3"
  },
  "build": {
    "appId": "com.eco.toolbox",
    "productName": "ECO 工具箱",
    "executableName": "ECO Toolbox",
    "asar": true,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "icon": "build/icon.ico",
    "publish": [
      {
        "provider": "github",
        "owner": "shaxiqaq",
        "repo": "eco-npc-translator",
        "releaseType": "release"
      }
    ],
    "files": [
      "main.js",
      "preload.js",
      "lib/**/*",
      "renderer/**/*",
      "overlay/**/*",
      "build/icon.ico",
      "build/icon.png",
      "assets/icon.ico",
      "node_modules/lucide/dist/umd/lucide.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "dist-python/damage",
        "to": "backend/damage"
      },
      {
        "from": "dist-python/translator",
        "to": "backend/translator"
      },
      {
        "from": "dist-python/agent",
        "to": "backend/agent"
      },
      {
        "from": "dist-native/icon-helper",
        "to": "icon-helper"
      },
      {
        "from": "build/icon.ico",
        "to": "icon.ico"
      },
      {
        "from": "dist-native/xiaoya-core",
        "to": "xiaoya-core"
      },
      {
        "from": "../data",
        "to": "data",
        "filter": [
          "skill_names.json",
          "skill_names_ja.json",
          "buff_names.json",
          "buff_meta.json",
          "mob_names.json",
          "defensive_skill_ids.json",
          "job_timer_presets.json",
          "exp_table.json"
        ]
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "ECO-Toolbox-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ECO 工具箱",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "deleteAppDataOnUninstall": false
    }
  }
}
