{
  "name": "eco-toolbox",
  "version": "0.2.6",
  "description": "ECO 本地工具箱：NPC 实时翻译、伤害统计、状态悬浮窗与技能计时",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "set ECO_UI_DEMO=1&& electron .",
    "build:ts": "tsc --build",
    "test": "node --test test/*.test.js",
    "build:backend": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-backend.ps1",
    "build:icons": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-icon-helper.ps1",
    "build:xiaoya-core": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-xiaoya-core.ps1",
    "test:xiaoya-core": "npm run build:xiaoya-core && node scripts/test-xiaoya-core.js",
    "build:prepackaged": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-prepackaged.ps1",
    "dist": "npm run build:backend && npm run build:icons && npm run build:xiaoya-core && npm run dist:ui",
    "dist:ui": "npm run build:prepackaged && set ELECTRON_BUILDER_BINARIES_MIRROR=https://npmmirror.com/mirrors/electron-builder-binaries/&& electron-builder --prepackaged release/win-unpacked --win nsis --publish never"
  },
  "dependencies": {
    "electron-updater": "^6.6.2",
    "iconv-lite": "^0.6.3",
    "lucide": "^0.468.0"
  },
  "devDependencies": {
    "@types/node": "^18.0.0",
    "electron": "^35.0.0",
    "electron-builder": "^26.0.0",
    "typescript": "^5.0.0"
  },
  "build": {
    "appId": "com.eco.toolbox",
    "productName": "ECO 工具箱",
    "executableName": "ECO Toolbox",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "shaxiqaq",
        "repo": "eco-npc-translator",
        "releaseType": "release"
      }
    ],
    "files": [
      "main.js",
      "preload.js",
      "lib/**/*",
      "renderer/**/*",
      "overlay/**/*",
      "node_modules/lucide/dist/umd/lucide.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "dist-python/damage",
        "to": "backend/damage"
      },
      {
        "from": "dist-python/translator",
        "to": "backend/translator"
      },
      {
        "from": "dist-native/icon-helper",
        "to": "icon-helper"
      },
      {
        "from": "dist-native/xiaoya-core",
        "to": "xiaoya-core"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "ECO-Toolbox-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ECO 工具箱",
      "deleteAppDataOnUninstall": false
    }
  }
}
